  CALLSUBR   SUBR(SQLSRV)
  CHGVAR     VAR(&MBR) VALUE('NWSHPSV')
  CALLSUBR   SUBR(SQLSRV)
  CHGVAR     VAR(&MBR) VALUE('NWREGSV')
