  CALLSUBR   SUBR(SQLSRV)

/* ---- Binding directory used by the display programs ------------- */
  CRTBNDDIR  BNDDIR(&APPLIB/NWBNDDIR) TEXT('Northwind service programs')
  MONMSG     MSGID(CPF2112)
  ADDBNDDIRE BNDDIR(&APPLIB/NWBNDDIR) OBJ((&APPLIB/NWUTIL *SRVPGM))
  MONMSG     MSGID(CPF0000)
  ADDBNDDIRE BNDDIR(&APPLIB/NWBNDDIR) OBJ((&APPLIB/NWCUSTSV *SRVPGM))
  MONMSG     MSGID(CPF0000)
  ADDBNDDIRE BNDDIR(&APPLIB/NWBNDDIR) OBJ((&APPLIB/NWEMPSV *SRVPGM))
