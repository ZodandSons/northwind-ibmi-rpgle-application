  CALLSUBR   SUBR(TEST)
  CHGVAR     VAR(&MBR) VALUE('TCDMSV')
  CHGVAR     VAR(&SRV) VALUE('NWCDMSV')
  CALLSUBR   SUBR(TEST)
  CHGVAR     VAR(&MBR) VALUE('TORDSV')
  CHGVAR     VAR(&SRV) VALUE('NWORDSV')
  CALLSUBR   SUBR(TEST)

SUMMARY:
  CHGVAR     VAR(&ERRTXT) VALUE(&ERRORS)
  IF         COND(&ERRORS *EQ 0) THEN(SNDPGMMSG MSGID(CPF9898) +
               MSGF(QCPFMSG) MSGDTA('Northwind build completed +
               successfully.') MSGTYPE(*COMP))
  ELSE       CMD(SNDPGMMSG MSGID(CPF9898) MSGF(QCPFMSG) +
               MSGDTA('Northwind build finished with' *BCAT &ERRTXT +
               *BCAT 'error(s). See the job log and spooled +
               compile listings.') MSGTYPE(*COMP))
  RETURN

/* ---- IMPORT: &E = source file(10) member(10) ext(10) type(10) ---- */
  SUBR       SUBR(IMPORT)
    CHGVAR     VAR(&SRCF) VALUE(%SST(&E 1 10))
    CHGVAR     VAR(&MBR)  VALUE(%SST(&E 11 10))
    CHGVAR     VAR(&EXT)  VALUE(%SST(&E 21 10))
    CHGVAR     VAR(&TYPE) VALUE(%SST(&E 31 10))
    CHGVAR     VAR(&STMF) VALUE(&SRCDIR *TCAT '/' *TCAT &SRCF *TCAT +
                 '/' *TCAT &MBR *TCAT '.' *TCAT &EXT)
    CHGVAR     VAR(&TOMBR) VALUE('/QSYS.LIB/' *TCAT &APPLIB *TCAT +
                 '.LIB/' *TCAT &SRCF *TCAT '.FILE/' *TCAT &MBR *TCAT +
                 '.MBR')
    CPYFRMSTMF FROMSTMF(&STMF) TOMBR(&TOMBR) MBROPT(*REPLACE) +
                 STMFCCSID(*STMF) DBFCCSID(*FILE) ENDLINFMT(*ALL)
    MONMSG     MSGID(CPF0000) EXEC(DO)
      CALLSUBR   SUBR(FAILED)
      RTNSUBR
    ENDDO
    CHGPFM     FILE(&APPLIB/&SRCF) MBR(&MBR) SRCTYPE(&TYPE)
    MONMSG     MSGID(CPF0000)
  ENDSUBR

/* ---- SQLSRV: SQLRPGLE module + service program -------------------- */
  SUBR       SUBR(SQLSRV)
    CRTSQLRPGI OBJ(&APPLIB/&MBR) SRCFILE(&APPLIB/QRPGLESRC) +
                 SRCMBR(&MBR) OBJTYPE(*MODULE) RPGPPOPT(*LVL2) +
                 DBGVIEW(*SOURCE) REPLACE(*YES)
    MONMSG     MSGID(CPF0000 SQL0000) EXEC(DO)
      CALLSUBR   SUBR(FAILED)
      RTNSUBR
    ENDDO
    CRTSRVPGM  SRVPGM(&APPLIB/&MBR) MODULE(&APPLIB/&MBR) +
                 EXPORT(*SRCFILE) SRCFILE(&APPLIB/QSRVSRC) +
                 SRCMBR(&MBR) BNDSRVPGM((&APPLIB/NWUTIL)) +
                 ACTGRP(*CALLER) REPLACE(*YES)
    MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  ENDSUBR

/* ---- DSPF ---------------------------------------------------------- */
  SUBR       SUBR(DSPF)
    CRTDSPF    FILE(&APPLIB/&MBR) SRCFILE(&APPLIB/QDDSSRC) +
                 SRCMBR(&MBR) RSTDSP(*YES) REPLACE(*YES)
    MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  ENDSUBR

/* ---- RPGPGM: bound RPG program (binds through NWBNDDIR) ----------- */
  SUBR       SUBR(RPGPGM)
    CRTBNDRPG  PGM(&APPLIB/&MBR) SRCFILE(&APPLIB/QRPGLESRC) +
                 SRCMBR(&MBR) DBGVIEW(*SOURCE) REPLACE(*YES)
    MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  ENDSUBR

/* ---- CLPGM ---------------------------------------------------------- */
  SUBR       SUBR(CLPGM)
    CRTBNDCL   PGM(&APPLIB/&MBR) SRCFILE(&APPLIB/QCLLESRC) +
                 SRCMBR(&MBR) DBGVIEW(*SOURCE) REPLACE(*YES)
    MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  ENDSUBR

/* ---- TEST: iRPGUnit suite (run through QCMDEXC so this program     */
/*      compiles on systems without iRPGUnit)                         */
  SUBR       SUBR(TEST)
    IF         COND(&SRV *EQ 'NWUTIL') THEN(CHGVAR VAR(&SRV) +
                 VALUE('NWTSTSV'))
    CHGVAR     VAR(&CMD) VALUE('RUCRTRPG TSTPGM(' *TCAT &APPLIB *TCAT +
                 '/' *TCAT &MBR *TCAT ') SRCFILE(' *TCAT &APPLIB *TCAT +
                 '/QTESTSRC) SRCMBR(' *TCAT &MBR *TCAT +
                 ') BNDSRVPGM((' *TCAT &APPLIB *TCAT '/NWUTIL)')
    IF         COND(&SRV *NE 'NWTSTSV') THEN(CHGVAR VAR(&CMD) +
                 VALUE(&CMD *TCAT ' (' *TCAT &APPLIB *TCAT '/' *TCAT +
                 &SRV *TCAT ')'))
    CHGVAR     VAR(&CMD) VALUE(&CMD *TCAT ' (' *TCAT &APPLIB *TCAT +
                 '/NWTSTSV))')
    CALL       PGM(QCMDEXC) PARM(&CMD &CMDLEN)
    MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  ENDSUBR

/* ---- FAILED: count and log ----------------------------------------- */
  SUBR       SUBR(FAILED)
    CHGVAR     VAR(&ERRORS) VALUE(&ERRORS + 1)
    SNDPGMMSG  MSG('NWBUILD: step failed for' *BCAT &MBR) +
                 TOPGMQ(*EXT) MSGTYPE(*INFO)
  ENDSUBR

ENDPGM
