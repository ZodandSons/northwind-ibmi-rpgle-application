/* ---- iRPGUnit test suites ----------------------------------------- */
  IF         COND(*NOT &UNIT) THEN(DO)
    SNDPGMMSG  MSG('Library RPGUNIT not found: unit tests not built.') +
                 MSGTYPE(*INFO)
    GOTO       CMDLBL(SUMMARY)
  ENDDO
  CHGVAR     VAR(&MBR) VALUE('TNWUTIL')
  CHGVAR     VAR(&SRV) VALUE('NWUTIL')
  CALLSUBR   SUBR(TEST)
  CHGVAR     VAR(&MBR) VALUE('TCUSTSV')
  CHGVAR     VAR(&SRV) VALUE('NWCUSTSV')
  CALLSUBR   SUBR(TEST)
  CHGVAR     VAR(&MBR) VALUE('TEMPSV')
