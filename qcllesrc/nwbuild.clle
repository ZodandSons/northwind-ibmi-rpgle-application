/* ---- Utility service program ------------------------------------- */
  CRTRPGMOD  MODULE(&APPLIB/NWUTIL) SRCFILE(&APPLIB/QRPGLESRC) +
               DBGVIEW(*SOURCE) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))
  CRTSRVPGM  SRVPGM(&APPLIB/NWUTIL) MODULE(&APPLIB/NWUTIL) +
               EXPORT(*SRCFILE) SRCFILE(&APPLIB/QSRVSRC) +
               ACTGRP(*CALLER) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CALLSUBR SUBR(FAILED))

/* ---- SQL data access service programs ---------------------------- */
  CHGVAR     VAR(&MBR) VALUE('NWCUSTSV')
  CALLSUBR   SUBR(SQLSRV)
  CHGVAR     VAR(&MBR) VALUE('NWEMPSV')
  CALLSUBR   SUBR(SQLSRV)
  CHGVAR     VAR(&MBR) VALUE('NWSUPSV')
  CALLSUBR   SUBR(SQLSRV)
  CHGVAR     VAR(&MBR) VALUE('NWCATSV')
