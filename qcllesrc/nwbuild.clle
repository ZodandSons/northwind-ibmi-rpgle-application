/*===================================================================*/
/* NWBUILD - Build the Northwind application from IFS stream files   */
/*                                                                   */
/* Parameters:                                                       */
/*   SRCDIR  IFS folder holding qrpglesrc, qcpysrc, qddssrc, ...     */
/*           (root file system, e.g. /home/me/northwind-ibmi)        */
/*   APPLIB  library for programs and source files   (e.g. NWAPP)    */
/*   DATALIB library holding the NORTHWIND tables    (NORTHWIND)     */
/*                                                                   */
/* Steps: create library + source files, copy every stream file to   */
/* a source member, then compile in dependency order:                */
/*   NWUTIL > data service programs > binding directory > display    */
/*   files > RPG programs > CL programs > iRPGUnit test suites.      */
/* Unit tests are built only when library RPGUNIT exists.            */
/*                                                                   */
/* SRCDIR is 128 bytes: from a command line pass it as (*CHAR 128):  */
/*   CALL NWAPP/NWBUILD PARM(('/home/me/northwind-ibmi' (*CHAR 128)) */
/*                           'NWAPP' 'NORTHWIND')                    */
/*===================================================================*/
PGM        PARM(&SRCDIR &APPLIB &DATALIB)

  DCL        VAR(&SRCDIR)  TYPE(*CHAR) LEN(128)
  DCL        VAR(&APPLIB)  TYPE(*CHAR) LEN(10)
  DCL        VAR(&DATALIB) TYPE(*CHAR) LEN(10)
  DCL        VAR(&E)       TYPE(*CHAR) LEN(40)
  DCL        VAR(&SRCF)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&MBR)     TYPE(*CHAR) LEN(10)
  DCL        VAR(&EXT)     TYPE(*CHAR) LEN(10)
  DCL        VAR(&TYPE)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&SRV)     TYPE(*CHAR) LEN(10)
  DCL        VAR(&STMF)    TYPE(*CHAR) LEN(256)
  DCL        VAR(&TOMBR)   TYPE(*CHAR) LEN(128)
  DCL        VAR(&CMD)     TYPE(*CHAR) LEN(512)
  DCL        VAR(&CMDLEN)  TYPE(*DEC)  LEN(15 5) VALUE(512)
  DCL        VAR(&ERRORS)  TYPE(*DEC)  LEN(5 0) VALUE(0)
  DCL        VAR(&ERRTXT)  TYPE(*CHAR) LEN(5)
  DCL        VAR(&UNIT)    TYPE(*LGL)  VALUE('1')

/* ---- Library, library list, source files ------------------------ */
  CRTLIB     LIB(&APPLIB) TEXT('Northwind Traders application')
  MONMSG     MSGID(CPF2111)
  ADDLIBLE   LIB(&APPLIB) POSITION(*FIRST)
  MONMSG     MSGID(CPF2103)
  ADDLIBLE   LIB(&DATALIB) POSITION(*LAST)
  MONMSG     MSGID(CPF2103)
  CHKOBJ     OBJ(QSYS/RPGUNIT) OBJTYPE(*LIB)
  MONMSG     MSGID(CPF9801) EXEC(CHGVAR VAR(&UNIT) VALUE('0'))
  IF         COND(&UNIT) THEN(DO)
    ADDLIBLE   LIB(RPGUNIT) POSITION(*LAST)
    MONMSG     MSGID(CPF2103)
  ENDDO

  CRTSRCPF   FILE(&APPLIB/QRPGLESRC) RCDLEN(112) TEXT('Northwind RPG source')
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(&APPLIB/QCPYSRC) RCDLEN(112) TEXT('Northwind RPG copybooks')
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(&APPLIB/QTESTSRC) RCDLEN(112) TEXT('Northwind unit tests')
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(&APPLIB/QDDSSRC) RCDLEN(92) TEXT('Northwind DDS source')
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(&APPLIB/QCLLESRC) RCDLEN(92) TEXT('Northwind CL source')
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(&APPLIB/QSRVSRC) RCDLEN(92) TEXT('Northwind Binder source')
  MONMSG     MSGID(CPF7302)

/* ---- Copy stream files to source members ------------------------- */
  CHGVAR     VAR(&E) VALUE('QCPYSRC   NWCOMMON  RPGLEINC  RPGLE     ')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&E) VALUE('QCPYSRC   NWUTILPR  RPGLEINC  RPGLE     ')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&E) VALUE('QCPYSRC   NWTSTPR   RPGLEINC  RPGLE     ')
