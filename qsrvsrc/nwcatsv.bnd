/* NWCATSV - CATEGORIES data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWCATSV V1')
  EXPORT SYMBOL(CAT_GET)
  EXPORT SYMBOL(CAT_EXISTS)
  EXPORT SYMBOL(CAT_VALIDATE)
  EXPORT SYMBOL(CAT_CREATE)
  EXPORT SYMBOL(CAT_UPDATE)
  EXPORT SYMBOL(CAT_DELETE)
  EXPORT SYMBOL(CAT_OPENLIST)
  EXPORT SYMBOL(CAT_FETCHNEXT)
  EXPORT SYMBOL(CAT_CLOSELIST)
ENDPGMEXP
