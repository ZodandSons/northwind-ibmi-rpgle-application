  EXPORT SYMBOL(TER_EXISTS)
  EXPORT SYMBOL(TER_VALIDATE)
  EXPORT SYMBOL(TER_CREATE)
  EXPORT SYMBOL(TER_UPDATE)
  EXPORT SYMBOL(TER_DELETE)
  EXPORT SYMBOL(TER_OPENLIST)
  EXPORT SYMBOL(TER_FETCHNEXT)
  EXPORT SYMBOL(TER_CLOSELIST)
  EXPORT SYMBOL(TER_REGIONIDDESC)
ENDPGMEXP
