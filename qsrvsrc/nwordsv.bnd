/* NWORDSV - orders and order lines                                     */
/* Add new exports at the END only to keep the signature stable.        */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWORDSV V1')
  EXPORT SYMBOL(ORD_CALCEXTPRICE)
  EXPORT SYMBOL(ORD_DEFAULTSHIPTO)
  EXPORT SYMBOL(ORD_VALIDATEHEADER)
  EXPORT SYMBOL(ORD_VALIDATELINE)
  EXPORT SYMBOL(ORD_CREATE)
  EXPORT SYMBOL(ORD_GET)
  EXPORT SYMBOL(ORD_DELETE)
  EXPORT SYMBOL(ORD_SUBTOTAL)
  EXPORT SYMBOL(ORD_OPENLINES)
  EXPORT SYMBOL(ORD_FETCHLINE)
  EXPORT SYMBOL(ORD_CLOSELINES)
  EXPORT SYMBOL(ORD_OPENLIST)
  EXPORT SYMBOL(ORD_FETCHLIST)
  EXPORT SYMBOL(ORD_CLOSELIST)
  EXPORT SYMBOL(ORD_CUSTOMERNAME)
  EXPORT SYMBOL(ORD_EMPLOYEENAME)
  EXPORT SYMBOL(ORD_SHIPPERNAME)
ENDPGMEXP
