  EXPORT SYMBOL(DEM_EXISTS)
  EXPORT SYMBOL(DEM_VALIDATE)
  EXPORT SYMBOL(DEM_CREATE)
  EXPORT SYMBOL(DEM_UPDATE)
  EXPORT SYMBOL(DEM_DELETE)
  EXPORT SYMBOL(DEM_OPENLIST)
  EXPORT SYMBOL(DEM_FETCHNEXT)
  EXPORT SYMBOL(DEM_CLOSELIST)
ENDPGMEXP
