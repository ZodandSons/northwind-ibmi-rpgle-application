/* NWUTIL - general utilities. Add new exports at the END only.          */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWUTIL V1')
  EXPORT SYMBOL(NWU_CLEARERROR)
  EXPORT SYMBOL(NWU_SETERROR)
  EXPORT SYMBOL(NWU_SQLERROR)
  EXPORT SYMBOL(NWU_SQLOK)
  EXPORT SYMBOL(NWU_TODATE)
  EXPORT SYMBOL(NWU_FROMDATE)
  EXPORT SYMBOL(NWU_WRAPTEXT)
  EXPORT SYMBOL(NWU_JOINTEXT)
  EXPORT SYMBOL(NWU_CENTER)
ENDPGMEXP
