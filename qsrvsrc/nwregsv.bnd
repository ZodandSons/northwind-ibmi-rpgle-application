/* NWREGSV - REGION data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWREGSV V1')
  EXPORT SYMBOL(REG_GET)
  EXPORT SYMBOL(REG_EXISTS)
  EXPORT SYMBOL(REG_VALIDATE)
  EXPORT SYMBOL(REG_CREATE)
  EXPORT SYMBOL(REG_UPDATE)
  EXPORT SYMBOL(REG_DELETE)
  EXPORT SYMBOL(REG_OPENLIST)
  EXPORT SYMBOL(REG_FETCHNEXT)
  EXPORT SYMBOL(REG_CLOSELIST)
  EXPORT SYMBOL(REG_NEXTKEY)
ENDPGMEXP
