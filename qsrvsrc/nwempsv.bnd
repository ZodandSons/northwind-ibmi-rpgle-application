/* NWEMPSV - EMPLOYEES data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWEMPSV V1')
  EXPORT SYMBOL(EMP_GET)
  EXPORT SYMBOL(EMP_EXISTS)
  EXPORT SYMBOL(EMP_VALIDATE)
  EXPORT SYMBOL(EMP_CREATE)
  EXPORT SYMBOL(EMP_UPDATE)
  EXPORT SYMBOL(EMP_DELETE)
  EXPORT SYMBOL(EMP_OPENLIST)
  EXPORT SYMBOL(EMP_FETCHNEXT)
  EXPORT SYMBOL(EMP_CLOSELIST)
  EXPORT SYMBOL(EMP_NEXTKEY)
  EXPORT SYMBOL(EMP_REPORTSTODESC)
ENDPGMEXP
