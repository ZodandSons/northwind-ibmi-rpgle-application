/* NWSHPSV - SHIPPERS data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWSHPSV V1')
  EXPORT SYMBOL(SHP_GET)
  EXPORT SYMBOL(SHP_EXISTS)
  EXPORT SYMBOL(SHP_VALIDATE)
  EXPORT SYMBOL(SHP_CREATE)
  EXPORT SYMBOL(SHP_UPDATE)
  EXPORT SYMBOL(SHP_DELETE)
  EXPORT SYMBOL(SHP_OPENLIST)
  EXPORT SYMBOL(SHP_FETCHNEXT)
  EXPORT SYMBOL(SHP_CLOSELIST)
ENDPGMEXP
