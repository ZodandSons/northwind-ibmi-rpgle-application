/* NWCUSTSV - CUSTOMERS data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWCUSTSV V1')
  EXPORT SYMBOL(CUST_GET)
  EXPORT SYMBOL(CUST_EXISTS)
  EXPORT SYMBOL(CUST_VALIDATE)
  EXPORT SYMBOL(CUST_CREATE)
  EXPORT SYMBOL(CUST_UPDATE)
  EXPORT SYMBOL(CUST_DELETE)
  EXPORT SYMBOL(CUST_OPENLIST)
  EXPORT SYMBOL(CUST_FETCHNEXT)
  EXPORT SYMBOL(CUST_CLOSELIST)
ENDPGMEXP
