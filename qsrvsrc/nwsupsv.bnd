/* NWSUPSV - SUPPLIERS data access */
/* Add new exports at the END only to keep the signature stable. */
STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('NWSUPSV V1')
  EXPORT SYMBOL(SUP_GET)
  EXPORT SYMBOL(SUP_EXISTS)
  EXPORT SYMBOL(SUP_VALIDATE)
  EXPORT SYMBOL(SUP_CREATE)
  EXPORT SYMBOL(SUP_UPDATE)
  EXPORT SYMBOL(SUP_DELETE)
  EXPORT SYMBOL(SUP_OPENLIST)
  EXPORT SYMBOL(SUP_FETCHNEXT)
  EXPORT SYMBOL(SUP_CLOSELIST)
ENDPGMEXP
