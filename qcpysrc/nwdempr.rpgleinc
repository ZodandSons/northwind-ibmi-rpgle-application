**free
//==============================================================================
// NWDEMPR - Prototypes and record template for NWDEMSV
//          (Northwind table CUSTOMERDEMOGRAPHICS)
//==============================================================================
/if defined(NWDEMPR)
/eof
/endif
/define NWDEMPR

/copy QCPYSRC,NWCOMMON

// One row of CUSTOMERDEMOGRAPHICS. Nullable columns are returned as blanks / zero /
// NW_NULL_DATE and written back as NULL.
dcl-ds CustDemo_t qualified template;
  CustomerTypeId char(10);      // key
  CustomerDesc   varchar(1024); // nullable, CLOB
end-ds;

// Retrieve one demographic by key
dcl-pr Dem_get ind;
  pCustomerTypeId like(CustDemo_t.CustomerTypeId) const;
  rec likeds(CustDemo_t);
  err likeds(NwError_t);
end-pr;

// *ON if the key exists
dcl-pr Dem_exists ind;
  pCustomerTypeId like(CustDemo_t.CustomerTypeId) const;
end-pr;

// Validate a record for ACTION_CREATE or ACTION_UPDATE
dcl-pr Dem_validate ind;
  rec    likeds(CustDemo_t) const;
  action char(1) const;
  err    likeds(NwError_t);
end-pr;

// Validate and insert
dcl-pr Dem_create ind;
  rec likeds(CustDemo_t);
  err likeds(NwError_t);
end-pr;

// Validate and update all non-key columns
dcl-pr Dem_update ind;
  rec likeds(CustDemo_t) const;
  err likeds(NwError_t);
end-pr;

// Delete by key
dcl-pr Dem_delete ind;
  pCustomerTypeId like(CustDemo_t.CustomerTypeId) const;
  err likeds(NwError_t);
end-pr;

// Open the list cursor positioned at customer type
dcl-pr Dem_openList ind;
  positionTo like(CustDemo_t.CustomerTypeId) const;
  err        likeds(NwError_t);
end-pr;

// Fetch next row; *OFF at end of list
dcl-pr Dem_fetchNext ind;
  rec likeds(CustDemo_t);
end-pr;

// Close the list cursor
dcl-pr Dem_closeList;
end-pr;

