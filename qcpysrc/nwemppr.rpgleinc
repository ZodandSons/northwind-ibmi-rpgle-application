**free
//==============================================================================
// NWEMPPR - Prototypes and record template for NWEMPSV
//          (Northwind table EMPLOYEES)
//==============================================================================
/if defined(NWEMPPR)
/eof
/endif
/define NWEMPPR

/copy QCPYSRC,NWCOMMON

// One row of EMPLOYEES. Nullable columns are returned as blanks / zero /
// NW_NULL_DATE and written back as NULL.
dcl-ds Employee_t qualified template;
  EmployeeId      int(10);       // key
  LastName        varchar(20);
  FirstName       varchar(10);
  Title           varchar(30);   // nullable
  TitleOfCourtesy varchar(25);   // nullable
  BirthDate       date;          // nullable
  HireDate        date;          // nullable
  Address         varchar(60);   // nullable
  City            varchar(15);   // nullable
  Region          varchar(15);   // nullable
  PostalCode      varchar(10);   // nullable
  Country         varchar(15);   // nullable
  HomePhone       varchar(24);   // nullable
  Extension       varchar(4);    // nullable
  ReportsTo       int(10);       // nullable, -> EMPLOYEES
  Notes           varchar(1024); // nullable, CLOB
end-ds;

// Retrieve one employee by key
dcl-pr Emp_get ind;
  pEmployeeId like(Employee_t.EmployeeId) const;
  rec likeds(Employee_t);
  err likeds(NwError_t);
end-pr;

// *ON if the key exists
dcl-pr Emp_exists ind;
  pEmployeeId like(Employee_t.EmployeeId) const;
end-pr;

// Validate a record for ACTION_CREATE or ACTION_UPDATE
dcl-pr Emp_validate ind;
  rec    likeds(Employee_t) const;
  action char(1) const;
  err    likeds(NwError_t);
end-pr;

// Validate and insert
dcl-pr Emp_create ind;
  rec likeds(Employee_t);
  err likeds(NwError_t);
end-pr;

// Validate and update all non-key columns
dcl-pr Emp_update ind;
  rec likeds(Employee_t) const;
  err likeds(NwError_t);
end-pr;

// Delete by key
dcl-pr Emp_delete ind;
  pEmployeeId like(Employee_t.EmployeeId) const;
  err likeds(NwError_t);
end-pr;

// Open the list cursor positioned at last name
dcl-pr Emp_openList ind;
  positionTo like(Employee_t.LastName) const;
  err        likeds(NwError_t);
end-pr;

// Fetch next row; *OFF at end of list
dcl-pr Emp_fetchNext ind;
  rec likeds(Employee_t);
end-pr;

// Close the list cursor
dcl-pr Emp_closeList;
end-pr;

// Suggested next free employee id
dcl-pr Emp_nextKey like(Employee_t.EmployeeId);
end-pr;

// Description of manager (blank if not found)
dcl-pr Emp_ReportsToDesc varchar(50);
  value like(Employee_t.ReportsTo) const;
end-pr;

