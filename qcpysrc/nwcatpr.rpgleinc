**free
//==============================================================================
// NWCATPR - Prototypes and record template for NWCATSV
//          (Northwind table CATEGORIES)
//==============================================================================
/if defined(NWCATPR)
/eof
/endif
/define NWCATPR

/copy QCPYSRC,NWCOMMON

// One row of CATEGORIES. Nullable columns are returned as blanks / zero /
// NW_NULL_DATE and written back as NULL.
dcl-ds Category_t qualified template;
  CategoryId   int(10);       // key (identity)
  CategoryName varchar(15);
  Description  varchar(1024); // nullable, CLOB
end-ds;

// Retrieve one category by key
dcl-pr Cat_get ind;
  pCategoryId like(Category_t.CategoryId) const;
  rec likeds(Category_t);
  err likeds(NwError_t);
end-pr;

// *ON if the key exists
dcl-pr Cat_exists ind;
  pCategoryId like(Category_t.CategoryId) const;
end-pr;

// Validate a record for ACTION_CREATE or ACTION_UPDATE
dcl-pr Cat_validate ind;
  rec    likeds(Category_t) const;
  action char(1) const;
  err    likeds(NwError_t);
end-pr;

// Validate and insert (identity key returned in rec)
dcl-pr Cat_create ind;
  rec likeds(Category_t);
  err likeds(NwError_t);
end-pr;

// Validate and update all non-key columns
dcl-pr Cat_update ind;
  rec likeds(Category_t) const;
  err likeds(NwError_t);
end-pr;

// Delete by key
dcl-pr Cat_delete ind;
  pCategoryId like(Category_t.CategoryId) const;
  err likeds(NwError_t);
end-pr;

// Open the list cursor positioned at category name
dcl-pr Cat_openList ind;
  positionTo like(Category_t.CategoryName) const;
  err        likeds(NwError_t);
end-pr;

// Fetch next row; *OFF at end of list
dcl-pr Cat_fetchNext ind;
  rec likeds(Category_t);
end-pr;

// Close the list cursor
dcl-pr Cat_closeList;
end-pr;

