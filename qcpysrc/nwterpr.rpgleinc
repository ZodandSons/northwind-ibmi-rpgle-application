**free
//==============================================================================
// NWTERPR - Prototypes and record template for NWTERSV
//          (Northwind table TERRITORIES)
//==============================================================================
/if defined(NWTERPR)
/eof
/endif
/define NWTERPR

/copy QCPYSRC,NWCOMMON

// One row of TERRITORIES. Nullable columns are returned as blanks / zero /
// NW_NULL_DATE and written back as NULL.
dcl-ds Territory_t qualified template;
  TerritoryId          varchar(20);   // key
  TerritoryDescription char(50);
  RegionId             int(10);       // -> REGION
end-ds;

// Retrieve one territory by key
dcl-pr Ter_get ind;
  pTerritoryId like(Territory_t.TerritoryId) const;
  rec likeds(Territory_t);
  err likeds(NwError_t);
end-pr;

// *ON if the key exists
dcl-pr Ter_exists ind;
  pTerritoryId like(Territory_t.TerritoryId) const;
end-pr;

// Validate a record for ACTION_CREATE or ACTION_UPDATE
dcl-pr Ter_validate ind;
  rec    likeds(Territory_t) const;
  action char(1) const;
  err    likeds(NwError_t);
end-pr;

// Validate and insert
dcl-pr Ter_create ind;
  rec likeds(Territory_t);
  err likeds(NwError_t);
end-pr;

// Validate and update all non-key columns
dcl-pr Ter_update ind;
  rec likeds(Territory_t) const;
  err likeds(NwError_t);
end-pr;

// Delete by key
dcl-pr Ter_delete ind;
  pTerritoryId like(Territory_t.TerritoryId) const;
  err likeds(NwError_t);
end-pr;

// Open the list cursor positioned at territory id
dcl-pr Ter_openList ind;
  positionTo like(Territory_t.TerritoryId) const;
  err        likeds(NwError_t);
end-pr;

// Fetch next row; *OFF at end of list
dcl-pr Ter_fetchNext ind;
  rec likeds(Territory_t);
end-pr;

// Close the list cursor
dcl-pr Ter_closeList;
end-pr;

// Description of region (blank if not found)
dcl-pr Ter_RegionIdDesc varchar(50);
  value like(Territory_t.RegionId) const;
end-pr;

