     A* ======================================================================
     A* WRKDEMD - Work with Customer Demographics (display file for WRKDEM)
     A* Records: SFL01/CTL01/FKEYS01 list, DETAIL, TEXT01, SFL02/CTL02/FKEYS02 d
     A* ======================================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      PRINT
     A                                      CA03(03 'Exit')
     A                                      CA12(12 'Cancel')
     A* List subfile
     A          R SFL01                     SFL
     A            S1OPT          1A  B  9  3VALUES(' ' '2' '3' '4' '5')
     A            S1TYPEID      10A  O  9  7
     A            S1DESC        60A  O  9 19
     A            H1TYPEID      10A  H
     A* List control
     A          R CTL01                     SFLCTL(SFL01)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      CF05(05 'Refresh')
     A                                      CF06(06 'Create')
     A                                      OVERLAY
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLCLR
     A  34                                  SFLEND(*MORE)
     A            C1RRN          4S 0H      SFLRCDNBR(CURSOR)
     A                                  1  2'WRKDEM'
     A                                  1 24'Work with Customer Demographics'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Position to type . . . .'
     A            C1POS         10A  B  3 27
     A                                  5  2'Type options, press Enter.'
     A                                      COLOR(BLU)
     A                                  6  4'2=Change   3=Copy   4=Delete'
     A                                      COLOR(BLU)
     A                                  6 35'5=Display'
     A                                      COLOR(BLU)
     A                                  8  2'Opt'
     A                                      DSPATR(HI)
     A                                  8  7'Type'
     A                                      DSPATR(HI)
     A                                  8 19'Description'
     A                                      DSPATR(HI)
     A* List function keys and message line
     A          R FKEYS01
     A                                      OVERLAY
     A                                 23  2'F3=Exit   F5=Refresh   F6=Create'
     A                                      COLOR(BLU)
     A                                 23 37'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG1          78A  O 24  2
     A                                      DSPATR(HI)
     A* Detail panel: create / change / copy / display
     A          R DETAIL
     A                                      CF10(10 'Text')
     A                                  1  2'WRKDEM'
     A            PTITLE        40A  O  1 21
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A            PINSTR        60A  O  3  2
     A                                      COLOR(BLU)
     A                                  5  2'Customer type  .'
     A            DTYPEID       10A  B  5 20
     A  41                                  DSPATR(PR)
     A  51                                  DSPATR(RI PC)
     A                                  6  2'Description  . .'
     A            DDESC         50A  O  6 20
     A                                  6 72'F10'
     A                                      COLOR(BLU)
     A  52                                  DSPATR(RI)
     A            PKEYS         78A  O 23  2
     A                                      COLOR(BLU)
     A            PMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Long text editor (CUSTOMERDESC)
     A          R TEXT01
     A                                  1  2'WRKDEM'
     A            TTITLE        40A  O  1 21
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A            TKEY          70A  O  3  2
     A            TX01          76A  B  5  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX02          76A  B  6  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX03          76A  B  7  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX04          76A  B  8  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX05          76A  B  9  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX06          76A  B 10  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX07          76A  B 11  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX08          76A  B 12  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX09          76A  B 13  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX10          76A  B 14  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX11          76A  B 15  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TX12          76A  B 16  3
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A            TKEYS         78A  O 23  2
     A                                      COLOR(BLU)
     A            TMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Confirm delete subfile
     A          R SFL02                     SFL
     A            X2OPT          1A  O  8  3
     A            X2TYPEID      10A  O  8  7
     A            X2DESC        60A  O  8 19
     A          R CTL02                     SFLCTL(SFL02)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      OVERLAY
     A  35                                  SFLDSP
     A  36                                  SFLDSPCTL
     A  37                                  SFLCLR
     A  38                                  SFLEND(*MORE)
     A                                  1  2'WRKDEM'
     A                                  1 20'Confirm Delete of Customer'
     A                                      DSPATR(HI)
     A                                  1 47'Demographics'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Press Enter to confirm your'
     A                                      COLOR(BLU)
     A                                  3 30'choices for 4=Delete.'
     A                                      COLOR(BLU)
     A                                  4  2'Press F12=Cancel to return to'
     A                                      COLOR(BLU)
     A                                  4 32'change your choices.'
     A                                      COLOR(BLU)
     A                                  7  2'Opt'
     A                                      DSPATR(HI)
     A                                  7  7'Type'
     A                                      DSPATR(HI)
     A                                  7 19'Description'
     A                                      DSPATR(HI)
     A          R FKEYS02
     A                                      OVERLAY
     A                                 23  2'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG2          78A  O 24  2
     A                                      DSPATR(HI)
