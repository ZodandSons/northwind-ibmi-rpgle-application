     A* ======================================================================
     A* WRKREGD - Work with Regions (display file for WRKREG)
     A* Records: SFL01/CTL01/FKEYS01 list, DETAIL, SFL02/CTL02/FKEYS02 delete
     A* ======================================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      PRINT
     A                                      CA03(03 'Exit')
     A                                      CA12(12 'Cancel')
     A* List subfile
     A          R SFL01                     SFL
     A            S1OPT          1A  B  9  3VALUES(' ' '2' '3' '4' '5')
     A            S1REGID        6Y 0O  9  7
     A                                      EDTCDE(4)
     A            S1REGDESC     50A  O  9 15
     A            H1REGID        9S 0H
     A* List control
     A          R CTL01                     SFLCTL(SFL01)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      CF05(05 'Refresh')
     A                                      CF06(06 'Create')
     A                                      OVERLAY
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLCLR
     A  34                                  SFLEND(*MORE)
     A            C1RRN          4S 0H      SFLRCDNBR(CURSOR)
     A                                  1  2'WRKREG'
     A                                  1 31'Work with Regions'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Position to region ID  .'
     A            C1POS          9Y 0B  3 27
     A                                      EDTCDE(4)
     A                                  5  2'Type options, press Enter.'
     A                                      COLOR(BLU)
     A                                  6  4'2=Change   3=Copy   4=Delete'
     A                                      COLOR(BLU)
     A                                  6 35'5=Display'
     A                                      COLOR(BLU)
     A                                  8  2'Opt'
     A                                      DSPATR(HI)
     A                                  8  7'ID'
     A                                      DSPATR(HI)
     A                                  8 15'Description'
     A                                      DSPATR(HI)
     A* List function keys and message line
     A          R FKEYS01
     A                                      OVERLAY
     A                                 23  2'F3=Exit   F5=Refresh   F6=Create'
     A                                      COLOR(BLU)
     A                                 23 37'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG1          78A  O 24  2
     A                                      DSPATR(HI)
     A* Detail panel: create / change / copy / display
     A          R DETAIL
     A                                  1  2'WRKREG'
     A            PTITLE        40A  O  1 21
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A            PINSTR        60A  O  3  2
     A                                      COLOR(BLU)
     A                                  5  2'Region ID  . . .'
     A            DREGID         9Y 0B  5 20
     A                                      EDTCDE(4)
     A  41                                  DSPATR(PR)
     A  51                                  DSPATR(RI PC)
     A                                  6  2'Description  . .'
     A            DREGDESC      50A  B  6 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  52                                  DSPATR(RI PC)
     A            PKEYS         78A  O 23  2
     A                                      COLOR(BLU)
     A            PMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Confirm delete subfile
     A          R SFL02                     SFL
     A            X2OPT          1A  O  8  3
     A            X2REGID        6Y 0O  8  7
     A                                      EDTCDE(4)
     A            X2REGDESC     50A  O  8 15
     A          R CTL02                     SFLCTL(SFL02)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      OVERLAY
     A  35                                  SFLDSP
     A  36                                  SFLDSPCTL
     A  37                                  SFLCLR
     A  38                                  SFLEND(*MORE)
     A                                  1  2'WRKREG'
     A                                  1 27'Confirm Delete of Regions'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Press Enter to confirm your'
     A                                      COLOR(BLU)
     A                                  3 30'choices for 4=Delete.'
     A                                      COLOR(BLU)
     A                                  4  2'Press F12=Cancel to return to'
     A                                      COLOR(BLU)
     A                                  4 32'change your choices.'
     A                                      COLOR(BLU)
     A                                  7  2'Opt'
     A                                      DSPATR(HI)
     A                                  7  7'ID'
     A                                      DSPATR(HI)
     A                                  7 15'Description'
     A                                      DSPATR(HI)
     A          R FKEYS02
     A                                      OVERLAY
     A                                 23  2'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG2          78A  O 24  2
     A                                      DSPATR(HI)
