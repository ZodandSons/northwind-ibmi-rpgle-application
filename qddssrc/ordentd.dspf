     A* ======================================================================
     A* ORDENTD - Order Entry (display file for ORDENT)
     A* ======================================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      PRINT
     A                                      CA03(03 'Exit')
     A                                      CA12(12 'Cancel')
     A* Order header panel
     A          R HDR
     A                                      CF04(04 'Prompt')
     A                                      CF05(05 'Ship-to defaults')
     A                                      RTNCSRLOC(&HRCD &HFLD)
     A                                  1  2'ORDENT'
     A                                  1 34'Order Entry'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A            HRCD          10A  H
     A            HFLD          10A  H
     A                                  3  2'Type order information, press'
     A                                      COLOR(BLU)
     A                                  3 32'Enter.'
     A                                      COLOR(BLU)
     A                                  5  2'Customer . . . . . .'
     A            HCUSTID        5A  B  5 24
     A  51                                  DSPATR(RI PC)
     A            HCUSTNM       40A  O  5 36
     A                                  6  2'Employee . . . . . .'
     A            HEMPID         9Y 0B  6 24
     A                                      EDTCDE(4)
     A  52                                  DSPATR(RI PC)
     A            HEMPNM        40A  O  6 36
     A                                  7  2'Order date . . . . .'
     A            HORDDT        10A  B  7 24
     A  53                                  DSPATR(RI PC)
     A                                  7 36'YYYY-MM-DD'
     A                                      COLOR(BLU)
     A                                  8  2'Required date  . . .'
     A            HREQDT        10A  B  8 24
     A  54                                  DSPATR(RI PC)
     A                                  8 36'YYYY-MM-DD'
     A                                      COLOR(BLU)
     A                                  9  2'Ship via . . . . . .'
     A            HSHPVIA        9Y 0B  9 24
     A                                      EDTCDE(4)
     A  55                                  DSPATR(RI PC)
     A            HSHPNM        40A  O  9 36
     A                                 10  2'Freight  . . . . . .'
     A            HFREIGHT       9Y 2B 10 24
     A                                      EDTCDE(1)
     A  56                                  DSPATR(RI PC)
     A                                 12  2'Ship to'
     A                                      DSPATR(HI)
     A                                 13  4'Name . . . . .'
     A            HSHPNAME      40A  B 13 20
     A                                      CHECK(LC)
     A  57                                  DSPATR(RI PC)
     A                                 14  4'Address  . . .'
     A            HSHPADDR      60A  B 14 20
     A                                      CHECK(LC)
     A  58                                  DSPATR(RI PC)
     A                                 15  4'City . . . . .'
     A            HSHPCITY      15A  B 15 20
     A                                      CHECK(LC)
     A  59                                  DSPATR(RI PC)
     A                                 16  4'Region . . . .'
     A            HSHPREG       15A  B 16 20
     A                                      CHECK(LC)
     A  60                                  DSPATR(RI PC)
     A                                 17  4'Postal code  .'
     A            HSHPPOST      10A  B 17 20
     A                                      CHECK(LC)
     A  61                                  DSPATR(RI PC)
     A                                 18  4'Country  . . .'
     A            HSHPCTRY      15A  B 18 20
     A                                      CHECK(LC)
     A  62                                  DSPATR(RI PC)
     A                                 23  2'F3=Exit   F4=Prompt   F5=Ship-to'
     A                                      COLOR(BLU)
     A                                 23 35'from customer   F12=Cancel order'
     A                                      COLOR(BLU)
     A            HMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Order lines (input subfile, 50 lines)
     A          R ENTSFL                    SFL
     A            LLINE          2Y 0O  8  2
     A                                      EDTCDE(4)
     A            LPRDID         5Y 0B  8  5
     A                                      EDTCDE(4)
     A  81                                  DSPATR(RI PC)
     A            LPRDNM        24A  O  8 11
     A            LPRICE         7Y 2B  8 36
     A                                      EDTCDE(1)
     A  82                                  DSPATR(RI PC)
     A            LQTY           4Y 0B  8 46
     A                                      EDTCDE(4)
     A  83                                  DSPATR(RI PC)
     A            LDISC          5Y 2B  8 52
     A                                      EDTCDE(4)
     A  84                                  DSPATR(RI PC)
     A            LEXT          11Y 2O  8 59
     A                                      EDTCDE(1)
     A            LPRVPRD        9S 0H
     A          R ENTCTL                    SFLCTL(ENTSFL)
     A                                      SFLSIZ(0050)
     A                                      SFLPAG(0012)
     A                                      CF04(04 'Prompt')
     A                                      CF10(10 'Submit')
     A                                      OVERLAY
     A                                      RTNCSRLOC(&LRCD &LFLD)
     A                                      SFLCSRRRN(&LCSRRRN)
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLCLR
     A  34                                  SFLEND(*MORE)
     A            LRCD          10A  H
     A            LFLD          10A  H
     A            LCSRRRN        5S 0H
     A            LRRN           4S 0H
     A                                      SFLRCDNBR(CURSOR)
     A                                  1  2'ORDENT'
     A                                  1 30'Order Entry - Lines'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Customer:'
     A            LCUSTID        5A  O  3 12
     A                                      DSPATR(HI)
     A            LCUSTNM       40A  O  3 18
     A                                  4  2'Ordered:'
     A            LORDDT        10A  O  4 12
     A                                  4 25'Required:'
     A            LREQDT        10A  O  4 35
     A                                  5  2'Type products and quantities,'
     A                                      COLOR(BLU)
     A                                  5 32'press Enter to price the order.'
     A                                      COLOR(BLU)
     A                                  7  1'Ln'
     A                                      DSPATR(HI)
     A                                  7  5'Prod'
     A                                      DSPATR(HI)
     A                                  7 11'Description'
     A                                      DSPATR(HI)
     A                                  7 38'Price'
     A                                      DSPATR(HI)
     A                                  7 46'Qty'
     A                                      DSPATR(HI)
     A                                  7 52'Disc%'
     A                                      DSPATR(HI)
     A                                  7 63'Extended'
     A                                      DSPATR(HI)
     A          R ENTFTR
     A                                 21  2'Lines:'
     A            LCOUNT         3Y 0O 21  9
     A                                      EDTCDE(3)
     A                                 21 14'Subtotal:'
     A            LSUBTOT        9Y 2O 21 24
     A                                      EDTCDE(1)
     A                                 21 39'Freight:'
     A            LFRT           9Y 2O 21 48
     A                                      EDTCDE(1)
     A                                 21 61'Total:'
     A            LTOTAL         9Y 2O 21 68
     A                                      EDTCDE(1)
     A                                      DSPATR(HI)
     A                                 23  2'F3=Exit   F4=Prompt   F10=Submit'
     A                                      COLOR(BLU)
     A                                 23 35'order   F12=Header'
     A                                      COLOR(BLU)
     A            LMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Select window (F4=Prompt) - customers, employees, shippers, products
     A          R WINSFL                    SFL
     A            WOPT           1A  B  5  2
     A                                      VALUES(' ' '1')
     A            WCODE         10A  O  5  6
     A            WDESC         37A  O  5 17
     A          R WINCTL                    SFLCTL(WINSFL)
     A                                      SFLSIZ(0011)
     A                                      SFLPAG(0010)
     A                                      WINDOW(4 12 16 55)
     A                                      OVERLAY
     A  71                                  SFLDSP
     A  72                                  SFLDSPCTL
     A  73                                  SFLCLR
     A  74                                  SFLEND(*MORE)
     A            WTITLE        40A  O  1  2
     A                                      DSPATR(HI)
     A                                  2  2'Position to . .'
     A            WPOS          20A  B  2 18
     A                                  3  2'1=Select   F12=Cancel'
     A                                      COLOR(BLU)
     A                                  4  2'Opt'
     A                                      DSPATR(HI)
     A            WHDR1         10A  O  4  6
     A                                      DSPATR(HI)
     A            WHDR2         37A  O  4 17
     A                                      DSPATR(HI)
