     A            WPOS          20A  B  2 18
     A                                  3  2'1=Select   F12=Cancel'
     A                                      COLOR(BLU)
     A                                  4  2'Opt'
     A                                      DSPATR(HI)
     A            WHDR1         10A  O  4  6
     A                                      DSPATR(HI)
     A            WHDR2         37A  O  4 17
     A                                      DSPATR(HI)
