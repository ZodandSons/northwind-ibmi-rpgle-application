     A* ======================================================================
     A* WRKCUSTD - Work with Customers (display file for WRKCUST)
     A* Records: SFL01/CTL01/FKEYS01 list, DETAIL, SFL02/CTL02/FKEYS02 delete
     A* ======================================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      PRINT
     A                                      CA03(03 'Exit')
     A                                      CA12(12 'Cancel')
     A* List subfile
     A          R SFL01                     SFL
     A            S1OPT          1A  B  9  3VALUES(' ' '2' '3' '4' '5')
     A            S1CUSTID       5A  O  9  7
     A            S1COMPANY     30A  O  9 14
     A            S1CITY        15A  O  9 46
     A            S1COUNTRY     15A  O  9 63
     A            H1CUSTID       5A  H
     A* List control
     A          R CTL01                     SFLCTL(SFL01)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      CF05(05 'Refresh')
     A                                      CF06(06 'Create')
     A                                      OVERLAY
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLCLR
     A  34                                  SFLEND(*MORE)
     A            C1RRN          4S 0H      SFLRCDNBR(CURSOR)
     A                                  1  2'WRKCUST'
     A                                  1 30'Work with Customers'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Position to customer ID'
     A            C1POS          5A  B  3 26
     A                                  5  2'Type options, press Enter.'
     A                                      COLOR(BLU)
     A                                  6  4'2=Change   3=Copy   4=Delete'
     A                                      COLOR(BLU)
     A                                  6 35'5=Display'
     A                                      COLOR(BLU)
     A                                  8  2'Opt'
     A                                      DSPATR(HI)
     A                                  8  7'ID'
     A                                      DSPATR(HI)
     A                                  8 14'Company'
     A                                      DSPATR(HI)
     A                                  8 46'City'
     A                                      DSPATR(HI)
     A                                  8 63'Country'
     A                                      DSPATR(HI)
     A* List function keys and message line
     A          R FKEYS01
     A                                      OVERLAY
     A                                 23  2'F3=Exit   F5=Refresh   F6=Create'
     A                                      COLOR(BLU)
     A                                 23 37'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG1          78A  O 24  2
     A                                      DSPATR(HI)
     A* Detail panel: create / change / copy / display
     A          R DETAIL
     A                                  1  2'WRKCUST'
     A            PTITLE        40A  O  1 21
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A            PINSTR        60A  O  3  2
     A                                      COLOR(BLU)
     A                                  5  2'Customer ID  . .'
     A            DCUSTID        5A  B  5 20
     A  41                                  DSPATR(PR)
     A  51                                  DSPATR(RI PC)
     A                                  6  2'Company name . .'
     A            DCOMPANY      40A  B  6 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  52                                  DSPATR(RI PC)
     A                                  7  2'Contact name . .'
     A            DCONTACT      30A  B  7 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  53                                  DSPATR(RI PC)
     A                                  8  2'Contact title  .'
     A            DCTITLE       30A  B  8 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  54                                  DSPATR(RI PC)
     A                                  9  2'Address  . . . .'
     A            DADDRESS      60A  B  9 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  55                                  DSPATR(RI PC)
     A                                 10  2'City . . . . . .'
     A            DCITY         15A  B 10 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  56                                  DSPATR(RI PC)
     A                                 11  2'Region . . . . .'
     A            DREGION       15A  B 11 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  57                                  DSPATR(RI PC)
     A                                 12  2'Postal code  . .'
     A            DPOSTAL       10A  B 12 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  58                                  DSPATR(RI PC)
     A                                 13  2'Country  . . . .'
     A            DCOUNTRY      15A  B 13 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  59                                  DSPATR(RI PC)
     A                                 14  2'Phone  . . . . .'
     A            DPHONE        24A  B 14 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  60                                  DSPATR(RI PC)
     A                                 15  2'Fax  . . . . . .'
     A            DFAX          24A  B 15 20
     A                                      CHECK(LC)
     A  40                                  DSPATR(PR)
     A  61                                  DSPATR(RI PC)
     A            PKEYS         78A  O 23  2
     A                                      COLOR(BLU)
     A            PMSG          78A  O 24  2
     A                                      DSPATR(HI)
     A* Confirm delete subfile
     A          R SFL02                     SFL
     A            X2OPT          1A  O  8  3
     A            X2CUSTID       5A  O  8  7
     A            X2COMPANY     30A  O  8 14
     A            X2CITY        15A  O  8 46
     A            X2COUNTRY     15A  O  8 63
     A          R CTL02                     SFLCTL(SFL02)
     A                                      SFLSIZ(0013)
     A                                      SFLPAG(0012)
     A                                      OVERLAY
     A  35                                  SFLDSP
     A  36                                  SFLDSPCTL
     A  37                                  SFLCLR
     A  38                                  SFLEND(*MORE)
     A                                  1  2'WRKCUST'
     A                                  1 26'Confirm Delete of Customers'
     A                                      DSPATR(HI)
     A                                  1 71DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 71TIME
     A                                  3  2'Press Enter to confirm your'
     A                                      COLOR(BLU)
     A                                  3 30'choices for 4=Delete.'
     A                                      COLOR(BLU)
     A                                  4  2'Press F12=Cancel to return to'
     A                                      COLOR(BLU)
     A                                  4 32'change your choices.'
     A                                      COLOR(BLU)
     A                                  7  2'Opt'
     A                                      DSPATR(HI)
     A                                  7  7'ID'
     A                                      DSPATR(HI)
     A                                  7 14'Company'
     A                                      DSPATR(HI)
     A                                  7 46'City'
     A                                      DSPATR(HI)
     A                                  7 63'Country'
     A                                      DSPATR(HI)
     A          R FKEYS02
     A                                      OVERLAY
     A                                 23  2'F12=Cancel'
     A                                      COLOR(BLU)
     A            MSG2          78A  O 24  2
     A                                      DSPATR(HI)
